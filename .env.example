PORT=3000
# URL pública HTTPS (Apple exige HTTPS para el webServiceURL). En desarrollo usa ngrok/cloudflared.
BASE_URL=https://tu-dominio.com
# Clave que usa el POS / personal para llamar a /api/scan y /api/redeem
STAFF_API_KEY=cambia-esta-clave-larga
DB_PATH=data/loyalty.db

# Programa de lealtad
PROGRAM_NAME=Mi Cafetería
STAMPS_REQUIRED=10
CASHBACK_RATE=0.05
REWARD_DISCOUNT_PCT=20
CURRENCY=USD
BRAND_BG=rgb(30, 41, 59)
BRAND_FG=rgb(255, 255, 255)
BRAND_LABEL=rgb(203, 213, 225)
BRAND_HEX=#1e293b

# Apple Wallet
APPLE_PASS_TYPE_ID=pass.com.tuempresa.fidelidad
APPLE_TEAM_ID=ABCDE12345
APPLE_WWDR_CERT=certs/wwdr.pem
APPLE_SIGNER_CERT=certs/signerCert.pem
APPLE_SIGNER_KEY=certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APNS_HOST=api.push.apple.com

# Google Wallet
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_CLASS_SUFFIX=fidelidad_v1
GOOGLE_SERVICE_ACCOUNT_FILE=certs/google-service-account.json
GOOGLE_ORIGINS=https://tu-dominio.com
GOOGLE_LOGO_URL=https://storage.googleapis.com/wallet-lab-tools-codelab-artifacts-public/pass_google_logo.jpg
